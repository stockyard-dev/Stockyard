# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /morph ./cmd/morph/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /morph /usr/local/bin/morph
EXPOSE 9750
ENV MORPH_DATA_DIR=/data PORT=9750
ENTRYPOINT ["morph", "serve"]
