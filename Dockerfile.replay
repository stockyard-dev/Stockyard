# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /replay ./cmd/replay/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /replay /usr/local/bin/replay
EXPOSE 9850
ENV REPLAY_DATA_DIR=/data PORT=9850
ENTRYPOINT ["replay", "agent"]
