# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /spine ./cmd/spine/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /spine /usr/local/bin/spine
EXPOSE 9700
VOLUME /data
ENV SPINE_DATA_DIR=/data PORT=9700
ENTRYPOINT ["spine", "serve"]
