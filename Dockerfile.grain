# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /grain ./cmd/grain/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /grain /usr/local/bin/grain
EXPOSE 9350
VOLUME /data
ENV GRAIN_DATA_DIR=/data PORT=9350
ENTRYPOINT ["grain", "serve"]
