# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /iron ./cmd/iron/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /iron /usr/local/bin/iron
VOLUME /data
ENV IRON_DATA_DIR=/data
ENTRYPOINT ["iron"]
