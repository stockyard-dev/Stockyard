{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stockyard Fabric Manifest",
  "version": "1.0.0",
  "description": "Declarative deployment manifest for Stockyard Fabric",
  "type": "object",
  "properties": {
    "name": {"type": "string", "description": "Deployment name"},
    "description": {"type": "string"},
    "version": {"type": "string"},
    "model": {"type": "string", "description": "Primary model"},
    "fallback_models": {"type": "array", "items": {"type": "string"}},
    "temperature": {"type": "number"},
    "max_tokens": {"type": "integer"},
    "system_prompt": {"type": "string"},
    "modules": {"type": "array", "items": {"type": "string"}},
    "module_config": {"type": "object"},
    "routing": {
      "type": "object",
      "properties": {
        "strategy": {"type": "string", "enum": ["round-robin", "weighted", "lowest-cost", "fastest"]},
        "weights": {"type": "object"},
        "fallback_chain": {"type": "array", "items": {"type": "string"}}
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "pattern": {"type": "string"},
          "action": {"type": "string", "enum": ["block", "warn", "redact"]},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]}
        }
      }
    },
    "auto_heal": {"type": "boolean"},
    "response_headers": {"type": "boolean"},
    "local_only": {"type": "boolean"}
  },
  "required": ["name", "model"]
}
