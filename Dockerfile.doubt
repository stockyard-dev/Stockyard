# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /doubt ./cmd/doubt/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /doubt /usr/local/bin/doubt
EXPOSE 9500
ENV DOUBT_DATA_DIR=/data PORT=9500
ENTRYPOINT ["doubt", "serve"]
