# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /echo ./cmd/echo/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /echo /usr/local/bin/echo
EXPOSE 9400
VOLUME /data
ENV ECHO_DATA_DIR=/data PORT=9400
ENTRYPOINT ["echo", "serve"]
