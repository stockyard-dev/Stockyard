# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /fossil ./cmd/fossil/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /fossil /usr/local/bin/fossil
EXPOSE 9300
VOLUME /data
ENV FOSSIL_DATA_DIR=/data PORT=9300
ENTRYPOINT ["fossil", "serve"]
