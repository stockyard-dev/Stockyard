# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bid ./cmd/bid/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /bid /usr/local/bin/bid
EXPOSE 9800
ENV PORT=9800
ENTRYPOINT ["bid", "serve"]
