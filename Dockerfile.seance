# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /seance ./cmd/seance/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /seance /usr/local/bin/seance
EXPOSE 9600
ENV SEANCE_DATA_DIR=/data PORT=9600
ENTRYPOINT ["seance", "serve"]
