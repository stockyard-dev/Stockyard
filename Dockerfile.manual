# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /stockyard ./cmd/stockyard/

# Runtime stage — scratch for minimal attack surface
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /stockyard /usr/local/bin/stockyard
EXPOSE 7749
VOLUME /data
ENV DATA_DIR=/data PORT=7749
ENTRYPOINT ["stockyard"]
