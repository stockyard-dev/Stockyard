# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /prism ./cmd/prism/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /prism /usr/local/bin/prism
EXPOSE 9250
VOLUME /data
ENV PRISM_DATA_DIR=/data PORT=9250
ENTRYPOINT ["prism", "serve"]
