# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /cortex ./cmd/cortex/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /cortex /usr/local/bin/cortex
EXPOSE 9950
VOLUME /data
ENV CORTEX_DATA_DIR=/data PORT=9950
ENTRYPOINT ["cortex", "serve"]
