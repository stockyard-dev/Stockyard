# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /trailhead ./cmd/trailhead/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /trailhead /usr/local/bin/trailhead
EXPOSE 9950
ENV TRAILHEAD_DATA_DIR=/data PORT=9950
ENTRYPOINT ["trailhead", "serve"]
